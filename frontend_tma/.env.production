# Build servita dal container `tma`, dietro Cloudflare Tunnel.
#
# API e Mini App stanno sulla stessa origine: nginx inoltra /api/ e /ws/ al
# backend. L'URL relativo evita il preflight CORS e rende la build
# indipendente dal dominio: cambiando hostname non serve ricompilare.
VITE_API_URL=/api/v1

# VITE_WS_URL non serve: viene ricavato dall'indirizzo corrente. Va
# impostato solo se l'API sta su un'altra origine.

# Modelli e runtime serviti dalla stessa origine (npm run fetch:models).
VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_lite.task
VITE_FACE_MODEL_URL=/mediapipe/face_landmarker.task
VITE_HAND_MODEL_URL=/mediapipe/hand_landmarker.task
VITE_WASM_BASE=/mediapipe/wasm
