# Build servita da Cloudflare Pages su https://syntaxnode.work
# L'API Django NON gira su Pages: va ospitata a parte e pubblicata qui.
VITE_API_URL=https://api.syntaxnode.work/api/v1
VITE_WS_URL=wss://api.syntaxnode.work/ws/assessments/

# Modelli e runtime serviti dalla stessa origine (npm run fetch:models).
