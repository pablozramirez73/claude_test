# Stessa origine dell'API: in sviluppo ci pensa il proxy di Vite, in
# produzione nginx dentro il container `tma`. Il WebSocket viene ricavato
# dall'indirizzo corrente, non serve configurarlo.
VITE_API_URL=/api/v1

# Solo se l'API sta su un'altra origine (per esempio Mini App su Cloudflare
# Pages e API su un sottodominio):
# VITE_API_URL=https://api.syntaxnode.work/api/v1
# VITE_WS_URL=wss://api.syntaxnode.work/ws/assessments/

# Modelli MediaPipe serviti dalla stessa origine (vedi npm run fetch:models).
VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_lite.task
VITE_FACE_MODEL_URL=/mediapipe/face_landmarker.task
VITE_HAND_MODEL_URL=/mediapipe/hand_landmarker.task
VITE_WASM_BASE=/mediapipe/wasm
