{
  "name": "ergocheck-tma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram Mini App per audit ergonomico D.Lgs 81/08",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "fetch:models": "node scripts/fetch-models.mjs",
    "build:prod": "npm run fetch:models && tsc -b && vite build --mode production",
    "deploy": "npm run build:prod && wrangler pages deploy dist --project-name ergocheck"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "wrangler": "^4.128.0"
  }
}
