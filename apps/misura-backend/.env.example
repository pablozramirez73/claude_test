# Copy to ".env" (same directory as docker-compose.yml) and adjust as
# needed. Safe to commit as-is (no real secrets); ".env" is gitignored.

# --- Ports on the HOST machine — change if these collide with something
# already running on your machine. ---
BACKEND_PORT=8099
BACKEND_DEV_PORT=8098
POSTGRES_PORT=5442

# --- Postgres ---
POSTGRES_DB=misura
POSTGRES_USER=misura
POSTGRES_PASSWORD=misura

# --- Django ---
# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call this API from a browser — the Mini App frontend's
# ports (see apps/misura-miniapp/.env.example).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8091,http://localhost:5183

# Salt used to hash the Telegram user id before storing it (docs/PRD-misura.md
# §10) — change it for anything beyond local dev; changing it later makes
# previously-hashed rows unmatchable against a fresh raw id, by design.
PROFILE_HASH_SALT=misura-dev-salt-change-me

# The bot TOKEN has no place here either — see apps/misura-miniapp/.env.example
# for why. This backend doesn't talk to the Telegram Bot API (yet); it's a
# storage API the Mini App or a future bot process can call.

# --- Local LLM (style/fit advice — profiles/llm.py) ---
# Talks to an Ollama instance YOU already run on this machine (e.g. `ollama
# serve`) — this project does not install, run, or pull anything itself.
# Default below assumes Ollama on the host's default port; the backend
# container reaches it via host.docker.internal (mapped in
# docker-compose.yml), not via this URL directly — override
# OLLAMA_BASE_URL only if your Ollama listens somewhere non-default.
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA_BASE_URL=http://host.docker.internal:11434
