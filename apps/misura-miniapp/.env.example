# Copy to ".env" (same directory as docker-compose.yml) and adjust as needed.
# This file is safe to commit (it holds no secrets); ".env" itself is
# gitignored so your local overrides never get pushed.

# docker compose host ports — change if 8091/5183 are already taken.
MISURA_WEB_PORT=8091
MISURA_DEV_PORT=5183

# Public bot username for the t.me share deep link (frontend, read by Vite —
# NOT a secret, safe to set here).
VITE_TELEGRAM_BOT_USERNAME=thpsh_bot

# The bot TOKEN is a secret and has no home in this frontend app at all — it
# belongs only to a server-side bot process (Telegraf, per docs/PRD-misura.md
# §8), which doesn't exist yet in this POC. When that backend is built, its
# token goes in *that app's own* .env (gitignored), read as
# process.env.TELEGRAM_BOT_TOKEN — never here, never committed, never in chat.
