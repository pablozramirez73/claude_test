# /srv/ergocheck/backend/.env — produzione
DJANGO_SECRET_KEY=<genera con: python -c "import secrets;print(secrets.token_urlsafe(64))">
DEBUG=False
# Il dominio pubblico su cui risponde l'app: e' l'hostname configurato
# nell'ingress del tunnel. Django rifiuta con 400 le richieste con un Host
# diverso, quindi va tenuto allineato.
ALLOWED_HOSTS=ergo.syntaxnode.work
SECURE_SSL_REDIRECT=False           # il redirect lo fa Cloudflare

CSRF_TRUSTED_ORIGINS=https://ergo.syntaxnode.work
TMA_URL=https://ergo.syntaxnode.work

# Serve solo se la Mini App e' su un'altra origine (Cloudflare Pages):
# senza questa voce il browser blocca ogni chiamata nel preflight.
# Con tutto sulla stessa origine puo' restare vuota.
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgres://ergocheck:<password>@localhost:5432/ergocheck
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=<token di @BotFather>
TELEGRAM_BOT_USERNAME=ErgoCheckBot
TELEGRAM_WEBHOOK_SECRET=<genera un valore casuale>

# Storage dei report.
# - lasciando tutto vuoto restano su disco in /srv/ergocheck/media
# - con R2_ACCOUNT_ID vanno su Cloudflare R2 (compatibile S3, egress gratuito)
# - con USE_S3=True e AWS_S3_ENDPOINT_URL su qualunque altro servizio S3
R2_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=ergocheck-reports
# Dominio pubblico collegato al bucket R2. Lasciandolo vuoto i PDF restano
# privati e accessibili solo tramite link firmato valido un'ora.
R2_PUBLIC_DOMAIN=

USE_S3=False
AWS_S3_REGION_NAME=eu-south-1
AWS_S3_ENDPOINT_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

ERGO_MIN_LUX=200
ERGO_MAX_NOISE_DB=80
ERGO_MAX_TILT_DEG=2
