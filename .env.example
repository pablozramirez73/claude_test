# .env della RADICE del progetto — letto da Docker Compose.
#
# Contiene solo variabili che compose deve sostituire dentro i file
# docker-compose*.yml (la sintassi ${...}). Qui dentro non va la
# configurazione di Django: quella sta in backend/.env e viene passata ai
# container cosi' com'e', senza sostituzioni.
#
# La separazione non e' pignoleria: compose interpreta il simbolo $ nei
# valori di questo file, quindi una password o una chiave che lo contiene
# verrebbe alterata. backend/.env non subisce alcuna interpretazione.
#
#   cp .env.example .env
#
# Con queste due voci `docker compose` include da solo l'override del
# tunnel, senza doverlo passare ogni volta con -f. Senza, un semplice
# `docker compose up` avvia lo stack ma NON il connettore, e il dominio
# resta irraggiungibile senza che nulla segnali l'errore.
# Il separatore va dichiarato perche' su Windows sarebbe ";" e il valore
# qui sopra non funzionerebbe.
COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
COMPOSE_PATH_SEPARATOR=:

# Token del connettore, dalla dashboard: Zero Trust -> Networks -> Tunnels
# -> il tuo tunnel -> Configure. Serve solo con docker-compose.tunnel.yml.
#
# E' la stringa che segue --token nel comando di installazione: inizia con
# "eyJ" ed e' lunga qualche centinaio di caratteri. Non e' il token API di
# Cloudflare (quello inizia con "cfat_"): scambiarli fa rispondere a
# cloudflared "Provided Tunnel token is not valid".
# Per controllarne la forma: python3 deploy/check-tunnel-token.py
CLOUDFLARE_TUNNEL_TOKEN=
