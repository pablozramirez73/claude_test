# For docker-compose.misura.yml (the full MISURA stack — db + backend +
# frontend, run together from the repo root). Copy to ".env" and adjust.
# Each app also has its own narrower .env.example for standalone use:
#   apps/misura-backend/.env.example
#   apps/misura-miniapp/.env.example

MISURA_WEB_PORT=8091
BACKEND_PORT=8099
POSTGRES_PORT=5442

POSTGRES_DB=misura
POSTGRES_USER=misura
POSTGRES_PASSWORD=misura

DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8091,http://localhost:5183
PROFILE_HASH_SALT=misura-dev-salt-change-me
